// mathlib_demo.c3pp — Implementation of mathlib interface
// This file imports declarations from mathlib.c3ppi and provides implementations

import std::io;
import mathlib;  // Import types, constants, and declarations from mathlib.c3ppi
// Note: _new constructors are auto-generated by the import

// ── Calculator method implementations ───────────────────────────────
fn void Calculator_set_precision(Calculator* self, int p) {
    self->precision = p;
}

fn int Calculator_get_precision(Calculator* self) {
    return self->precision;
}

fn double Calculator_calculate(Calculator* self, MathOperation op, double a, double b) {
    if (op == ADD) {
        return a + b;
    }
    if (op == SUBTRACT) {
        return a - b;
    }
    if (op == MULTIPLY) {
        return a * b;
    }
    if (op == DIVIDE) {
        return a / b;
    }
    return 0;
}

fn void Calculator_reset(Calculator* self) {
    io::printfn("Calculator '%s' reset", self->name);
}

// ── Statistics method implementations ───────────────────────────────
fn void Statistics_add_value(Statistics* self, double v) {
    self->count = self->count + 1;
}

fn double Statistics_mean(Statistics* self) {
    return 0;
}

fn double Statistics_variance(Statistics* self) {
    return 0;
}

fn double Statistics_std_dev(Statistics* self) {
    return 0;
}

fn void Statistics_clear(Statistics* self) {
    self->count = 0;
}

// ── Free function implementations ───────────────────────────────────
fn double math_abs(double x) {
    if (x < 0) {
        return -x;
    }
    return x;
}

fn double c3_sqrt(double x) {
    if (x < 0) {
        return 0;
    }
    double guess = x / 2;
    int i = 0;
    while (i < 50) {
        guess = (guess + x / guess) / 2;
        i++;
    }
    return guess;
}

fn int math_min(int a, int b) {
    if (a < b) {
        return a;
    }
    return b;
}

fn int math_max(int a, int b) {
    if (a > b) {
        return a;
    }
    return b;
}

fn int clamp(int val, int lo, int hi) {
    if (val < lo) {
        return lo;
    }
    if (val > hi) {
        return hi;
    }
    return val;
}

fn int factorial(int n) {
    int result = 1;
    int i = 2;
    while (i <= n) {
        result = result * i;
        i++;
    }
    return result;
}

fn int fibonacci(int n) {
    if (n <= 0) {
        return 0;
    }
    if (n == 1) {
        return 1;
    }
    int a = 0;
    int b = 1;
    int i = 2;
    while (i <= n) {
        int temp = a + b;
        a = b;
        b = temp;
        i++;
    }
    return b;
}

fn Vec2 vec2_new(double x, double y) {
    Vec2 v;
    v.x = x;
    v.y = y;
    return v;
}

fn double vec2_length(Vec2 v) {
    return c3_sqrt(v.x * v.x + v.y * v.y);
}

fn Vec2 vec2_add(Vec2 a, Vec2 b) {
    return vec2_new(a.x + b.x, a.y + b.y);
}

fn Vec2 vec2_scale(Vec2 v, double s) {
    return vec2_new(v.x * s, v.y * s);
}

fn double vec2_dot(Vec2 a, Vec2 b) {
    return a.x * b.x + a.y * b.y;
}

fn Vec3 vec3_new(double x, double y, double z) {
    Vec3 v;
    v.x = x;
    v.y = y;
    v.z = z;
    return v;
}

// ── Main ────────────────────────────────────────────────────────────
fn void main() {
    io::printn("=== Math Library Demo ===");
    io::printn("");

    // Calculator demo
    Calculator calc = Calculator_new("MyCalc", 2);
    io::printfn("Calculator: %s (precision: %d)", calc.name, calc.precision);

    double result = Calculator_calculate(&calc, ADD, 10, 5);
    io::printfn("10 + 5 = %.2f", result);

    result = Calculator_calculate(&calc, MULTIPLY, 3, 7);
    io::printfn("3 * 7 = %.2f", result);

    Calculator_set_precision(&calc, 4);
    io::printfn("Precision set to: %d", Calculator_get_precision(&calc));

    io::printn("");

    // Math functions
    io::printn("Math functions:");
    io::printfn("  math_abs(-42) = %.2f", math_abs(-42));
    io::printfn("  clamp(15, 0, 10) = %d", clamp(15, 0, 10));
    io::printfn("  factorial(5) = %d", factorial(5));
    io::printfn("  fibonacci(10) = %d", fibonacci(10));

    io::printn("");

    // Vector operations
    io::printn("Vector operations:");
    Vec2 v1 = vec2_new(3, 4);
    io::printfn("  v1 = (%.1f, %.1f)", v1.x, v1.y);
    io::printfn("  |v1| = %.2f", vec2_length(v1));

    Vec2 v2 = vec2_new(1, 2);
    Vec2 v3 = vec2_add(v1, v2);
    io::printfn("  v1 + v2 = (%.1f, %.1f)", v3.x, v3.y);

    io::printn("");
    io::printn("All math functions working!");
}
