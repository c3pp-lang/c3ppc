const unsigned int FLAG_WINDOW_MAXIMIZED        = 0x00000400;
const unsigned int FLAG_WINDOW_UNFOCUSED        = 0x00000800;
const unsigned int FLAG_WINDOW_TOPMOST          = 0x00001000;
const unsigned int FLAG_WINDOW_ALWAYS_RUN       = 0x00000100;
const unsigned int FLAG_WINDOW_TRANSPARENT      = 0x00000002;
const unsigned int FLAG_WINDOW_HIGHDPI          = 0x00002000;
const unsigned int FLAG_WINDOW_MOUSE_PASSTHROUGH= 0x00004000;
const unsigned int FLAG_BORDERLESS_WINDOWED_MODE= 0x00008000;
const unsigned int FLAG_MSAA_4X_HINT            = 0x00000020;
const unsigned int FLAG_INTERLACED_HINT         = 0x00010000;

