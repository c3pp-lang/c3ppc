// raylib6.c3ppi — C3++ interface for Raylib 6
// Declares types, constants, and function signatures in C3++ syntax.
//
// Usage in C3++ source:
//   import vendor::raylib6;
//   raylib6::InitWindow(800, 450, "Title");
//   raylib6::BeginDrawing();
//   raylib6::DrawText("Hello", 10, 10, 20, RED);
//   raylib6::EndDrawing();
//   raylib6::CloseWindow();

module vendor::raylib6;

// ── Core types ──────────────────────────────────────────────────

struct Vector2 {
    float x;
    float y;
}

struct Vector3 {
    float x;
    float y;
    float z;
}

struct Vector4 {
    float x;
    float y;
    float z;
    float w;
}

struct Matrix {
    float m0;
    float m1;
    float m2;
    float m3;
    float m4;
    float m5;
    float m6;
    float m7;
    float m8;
    float m9;
    float m10;
    float m11;
    float m12;
    float m13;
    float m14;
    float m15;
}

struct Color {
    unsigned char r;
    unsigned char g;
    unsigned char b;
    unsigned char a;
}

struct Rectangle {
    float x;
    float y;
    float width;
    float height;
}

struct Image {
    void *data;
    int width;
    int height;
    int mipmaps;
    int format;
}

struct Texture {
    unsigned int id;
    int width;
    int height;
    int mipmaps;
    int format;
}

struct RenderTexture {
    unsigned int id;
    Texture texture;
    Texture depth;
}

struct NPatchInfo {
    Rectangle source;
    int layout;
    int left;
    int top;
    int right;
    int bottom;
}

struct GlyphInfo {
    int value;
    int offsetX;
    int offsetY;
    int advanceX;
    Image image;
}

struct Font {
    int baseSize;
    int glyphCount;
    int glyphPadding;
    Texture texture;
    Rectangle *recs;
    GlyphInfo *glyphs;
}

struct Camera2D {
    Vector2 offset;
    Vector2 target;
    float rotation;
    float zoom;
}

struct Camera3D {
    Vector3 position;
    Vector3 target;
    Vector3 up;
    float fovy;
    int projection;
}

struct Ray {
    Vector3 position;
    Vector3 direction;
}

struct RayCollision {
    int hit;
    float distance;
    Vector3 point;
    Vector3 normal;
}

struct BoundingBox {
    Vector3 min;
    Vector3 max;
}

struct Wave {
    unsigned int frameCount;
    unsigned int sampleRate;
    unsigned int sampleSize;
    unsigned int channels;
    void *data;
}

struct Sound {
    unsigned int frameCount;
    unsigned int stream;
    unsigned int streamBufferSize;
}

struct Music {
    int ctxType;
    void *ctxData;
    unsigned int frameCount;
    unsigned int looping;
    int streamType;
    unsigned int sampleRate;
    unsigned int sampleSize;
    unsigned int channels;
    unsigned int loopBegin;
    unsigned int loopEnd;
    void *data;
}

struct AudioStream {
    unsigned int sampleRate;
    unsigned int sampleSize;
    unsigned int channels;
    void *buffer;
    void *processor;
}

struct MaterialMap {
    Texture texture;
    Color color;
    float value;
}

struct Material {
    MaterialMap maps[12];
    float params[4];
    void *shader;
}

struct Mesh {
    int vertexCount;
    int triangleCount;
    float *vertices;
    float *texcoords;
    float *texcoords2;
    float *normals;
    float *tangents;
    unsigned char *colors;
    unsigned short *indices;
    float *animVertices;
    float *animNormals;
    unsigned char *boneIds;
    float *boneWeights;
    unsigned int vaoId;
    unsigned int vboId[7];
}

struct Model {
    Matrix transform;
    int meshCount;
    int materialCount;
    Mesh *meshes;
    Material *materials;
    int *meshMaterial;
    int boneCount;
    char **boneNames;
}

struct ModelAnimation {
    int boneCount;
    int frameCount;
    char **boneNames;
}

struct Shader {
    unsigned int id;
    int *locs;
}

