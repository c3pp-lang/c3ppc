// ═══════════════════════════════════════════════════════════════════
//  Function declarations
// ═══════════════════════════════════════════════════════════════════

// Window
fn void InitWindow(int width, int height, char *title);
fn void CloseWindow();
fn int  WindowShouldClose();
fn int  IsWindowReady();
fn void ToggleFullscreen();
fn void SetWindowTitle(char *title);
fn void SetWindowSize(int width, int height);
fn void SetWindowPosition(int x, int y);
fn int  GetScreenWidth();
fn int  GetScreenHeight();
fn int  GetMonitorCount();
fn int  GetCurrentMonitor();
fn void SetTargetFPS(int fps);
fn int  GetFPS();
fn float GetFrameTime();
fn double GetTime();

// Cursor
fn void ShowCursor();
fn void HideCursor();
fn int  IsCursorHidden();
fn void EnableCursor();
fn void DisableCursor();

// Drawing
fn void BeginDrawing();
fn void EndDrawing();
fn void ClearBackground(Color color);
fn void BeginMode2D(Camera2D camera);
fn void EndMode2D();
fn void BeginMode3D(Camera3D camera);
fn void EndMode3D();
fn void BeginTextureMode(RenderTexture target);
fn void EndTextureMode();
fn void BeginShaderMode(Shader shader);
fn void EndShaderMode();
fn void BeginBlendMode(int mode);
fn void EndBlendMode();
fn void BeginScissorMode(int x, int y, int width, int height);
fn void EndScissorMode();

// Input - Mouse
fn int  GetMouseX();
fn int  GetMouseY();
fn Vector2 GetMousePosition();
fn Vector2 GetMouseDelta();
fn void SetMousePosition(int x, int y);
fn void SetMouseScale(float scaleX, float scaleY);
fn float GetMouseWheelMove();
fn void SetMouseCursor(int cursor);

// Input - Keyboard
fn int  IsKeyPressed(int key);
fn int  IsKeyPressedRepeat(int key);
fn int  IsKeyDown(int key);
fn int  IsKeyReleased(int key);
fn int  IsKeyUp(int key);
fn int  GetKeyPressed();
fn int  GetCharPressed();
fn void SetExitKey(int key);

// Input - Gamepad
fn int  IsGamepadAvailable(int gamepad);
fn char *GetGamepadName(int gamepad);
fn int  IsGamepadButtonPressed(int gamepad, int button);
fn int  IsGamepadButtonDown(int gamepad, int button);
fn int  IsGamepadButtonReleased(int gamepad, int button);
fn int  IsGamepadButtonUp(int gamepad, int button);
fn int  GetGamepadButtonPressed();
fn int  GetGamepadAxisMovement(int gamepad, int axis);

// Input - Touch
fn int  GetTouchX();
fn int  GetTouchY();
fn Vector2 GetTouchPosition(int finger);
fn int  GetTouchPointCount();

// Input - Gestures
fn void SetGesturesEnabled(unsigned int flags);
fn int  IsGestureDetected(unsigned int gesture);
fn int  GetGestureDetected();
fn float GetGestureHoldDuration();
fn Vector2 GetGestureDragVector();
fn float GetGestureDragAngle();
fn Vector2 GetGesturePinchVector();
fn float GetGesturePinchAngle();

// Shapes - 2D
fn void DrawPixel(int posX, int posY, Color color);
fn void DrawLine(int startPosX, int startPosY, int endPosX, int endPosY, Color color);
fn void DrawLineV(Vector2 startPos, Vector2 endPos, Color color);
fn void DrawLineEx(Vector2 startPos, Vector2 endPos, float thick, Color color);
fn void DrawCircle(int centerX, int centerY, float radius, Color color);
fn void DrawCircleV(Vector2 center, float radius, Color color);
fn void DrawCircleLines(int centerX, int centerY, float radius, Color color);
fn void DrawRectangle(int posX, int posY, int width, int height, Color color);
fn void DrawRectangleV(Vector2 position, Vector2 size, Color color);
fn void DrawRectangleRec(Rectangle rec, Color color);
fn void DrawRectanglePro(Rectangle rec, Vector2 origin, float rotation, Color color);
fn void DrawRectangleLines(int posX, int posY, int width, int height, Color color);
fn void DrawRectangleLinesEx(Rectangle rec, int lineThick, Color color);
fn void DrawRectangleRounded(Rectangle rec, float roundness, int segments, Color color);
fn void DrawTriangle(Vector2 v1, Vector2 v2, Vector2 v3, Color color);
fn void DrawPoly(Vector2 center, int sides, float radius, float rotation, Color color);

// Shapes - 3D
fn void DrawCube(Vector3 position, float width, float height, float length, Color color);
fn void DrawSphere(Vector3 centerPos, float radius, Color color);
fn void DrawPlane(Vector3 centerPos, Vector2 size, Color color);
fn void DrawGrid(int slices, float spacing);

// Collision
fn int  CheckCollisionRecs(Rectangle rec1, Rectangle rec2);
fn int  CheckCollisionCircles(Vector2 center1, float radius1, Vector2 center2, float radius2);
fn int  CheckCollisionCircleRec(Vector2 center, float radius, Rectangle rec);
fn int  CheckCollisionPointRec(Vector2 point, Rectangle rec);
fn RayCollision GetRayCollisionSphere(Ray ray, Vector3 center, float radius);
fn RayCollision GetRayCollisionBox(Ray ray, BoundingBox box);

// Text
fn void DrawFPS(int posX, int posY);
fn void DrawText(char *text, int posX, int posY, int fontSize, Color color);
fn void DrawTextEx(Font font, char *text, Vector2 position, float fontSize, float spacing, Color tint);
fn Font LoadFont(char *fileName);
fn void UnloadFont(Font font);
fn int  MeasureText(char *text, int fontSize);
fn Vector2 MeasureTextEx(Font font, char *text, float fontSize, float spacing);

// Textures - Images
fn Image LoadImage(char *fileName);
fn void UnloadImage(Image image);
fn Image GenImageColor(int width, int height, Color color);
fn void ImageFormat(Image *image, int newFormat);
fn void ImageResize(Image *image, int newWidth, int newHeight);

// Textures
fn Texture LoadTexture(char *fileName);
fn Texture LoadTextureFromImage(Image image);
fn RenderTexture LoadRenderTexture(int width, int height);
fn void UnloadTexture(Texture texture);
fn void UnloadRenderTexture(RenderTexture target);
fn void SetTextureFilter(Texture texture, int filter);
fn void DrawTexture(Texture texture, int posX, int posY, Color tint);
fn void DrawTextureEx(Texture texture, Vector2 position, float rotation, float scale, Color tint);
fn void DrawTextureRec(Texture texture, Rectangle source, Vector2 position, Color tint);
fn void DrawTexturePro(Texture texture, Rectangle source, Rectangle dest, Vector2 origin, float rotation, Color tint);

// Color
fn Color Fade(Color color, float alpha);
fn int  ColorToInt(Color color);
fn Color ColorFromHSV(float hue, float saturation, float value);
fn Color GetColor(unsigned int hexValue);
fn int  GetPixelDataSize(int width, int height, int format);

// Models
fn Model LoadModel(char *fileName);
fn void UnloadModel(Model model);
fn void DrawModel(Model model, Vector3 position, float scale, Color tint);
fn void DrawBoundingBox(BoundingBox box, Color color);
fn Mesh GenMeshSphere(float radius, int rings, int slices);
fn Mesh GenMeshCube(float width, float height, float length);
fn void UnloadMesh(Mesh *mesh);

// Audio
fn void InitAudioDevice();
fn void CloseAudioDevice();
fn void SetMasterVolume(float volume);
fn Sound LoadSound(char *fileName);
fn void UnloadSound(Sound sound);
fn void PlaySound(Sound sound);
fn void StopSound(Sound sound);
fn void SetSoundVolume(Sound sound, float volume);
fn Music LoadMusicStream(char *fileName);
fn void UnloadMusicStream(Music music);
fn void PlayMusicStream(Music music);
fn void UpdateMusicStream(Music music);
fn void SetMusicVolume(Music music, float volume);
