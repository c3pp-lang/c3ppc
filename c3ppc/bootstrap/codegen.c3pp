// Code generator for C3++ bootstrapping compiler
// Generates C code from AST

module c3ppc.codegen;

import c3ppc.tokens;
import c3ppc.ast;

// Code generator class
class CodeGenerator {
    string output;
    int indent;
    
    // Constructor
    CodeGenerator() {
        this.output = "";
        this.indent = 0;
    }
    
    // Generate C code from AST
    string generate(ASTNode program) {
        output = "";
        
        // Generate header
        emit("/* Generated by c3ppc bootstrap compiler */");
        emit("#include <stdio.h>");
        emit("#include <stdlib.h>");
        emit("#include <string.h>");
        emit("");
        
        // Generate program
        if (program is ProgramNode) {
            generateProgram(program as ProgramNode);
        }
        
        return output;
    }
    
    // Generate program
    void generateProgram(ProgramNode program) {
        // Generate imports as includes
        for (int i = 0; i < program.imports.length; i++) {
            if (program.imports[i] is ImportDeclNode) {
                generateImport(program.imports[i] as ImportDeclNode);
            }
        }
        
        emit("");
        
        // Generate declarations
        for (int i = 0; i < program.declarations.length; i++) {
            generateDeclaration(program.declarations[i]);
        }
    }
    
    // Generate import
    void generateImport(ImportDeclNode import) {
        emit("#include \"" + import.path + ".h\"");
    }
    
    // Generate declaration
    void generateDeclaration(ASTNode decl) {
        if (decl is FnDeclNode) {
            generateFnDecl(decl as FnDeclNode);
        } else if (decl is ClassDeclNode) {
            generateClassDecl(decl as ClassDeclNode);
        } else if (decl is VarDeclNode) {
            generateVarDecl(decl as VarDeclNode);
        }
    }
    
    // Generate function declaration
    void generateFnDecl(FnDeclNode fn) {
        string returnType = "void";
        if (fn.returnType is BasicTypeNode) {
            returnType = (fn.returnType as BasicTypeNode).name;
        }
        
        // Generate parameters
        string params = "";
        for (int i = 0; i < fn.params.length; i++) {
            if (fn.params[i] is FnParamNode) {
                FnParamNode param = fn.params[i] as FnParamNode;
                string paramType = "int";
                if (param.typeAnnotation is BasicTypeNode) {
                    paramType = (param.typeAnnotation as BasicTypeNode).name;
                }
                if (i > 0) params += ", ";
                params += paramType + " " + param.name;
            }
        }
        
        if (params == "") params = "void";
        
        emit(returnType + " " + fn.name + "(" + params + ")");
        
        // Generate body
        if (fn.body is BlockNode) {
            generateBlock(fn.body as BlockNode);
        } else {
            emit(";");
        }
        
        emit("");
    }
    
    // Generate class declaration
    void generateClassDecl(ClassDeclNode classDecl) {
        emit("/* Class " + classDecl.name + " */");
        emit("struct " + classDecl.name + " {");
        indent++;
        
        if (classDecl.body is BlockNode) {
            BlockNode body = classDecl.body as BlockNode;
            for (int i = 0; i < body.statements.length; i++) {
                if (body.statements[i] is VarDeclNode) {
                    generateVarDecl(body.statements[i] as VarDeclNode);
                }
            }
        }
        
        indent--;
        emit("};");
        emit("");
        
        // Generate methods
        if (classDecl.body is BlockNode) {
            BlockNode body = classDecl.body as BlockNode;
            for (int i = 0; i < body.statements.length; i++) {
                if (body.statements[i] is FnDeclNode) {
                    generateMethod(classDecl.name, body.statements[i] as FnDeclNode);
                }
            }
        }
    }
    
    // Generate method
    void generateMethod(string className, FnDeclNode fn) {
        string returnType = "void";
        if (fn.returnType is BasicTypeNode) {
            returnType = (fn.returnType as BasicTypeNode).name;
        }
        
        // Generate parameters (first param is self)
        string params = "struct " + className + "* self";
        for (int i = 0; i < fn.params.length; i++) {
            if (fn.params[i] is FnParamNode) {
                FnParamNode param = fn.params[i] as FnParamNode;
                string paramType = "int";
                if (param.typeAnnotation is BasicTypeNode) {
                    paramType = (param.typeAnnotation as BasicTypeNode).name;
                }
                params += ", " + paramType + " " + param.name;
            }
        }
        
        emit(returnType + " " + className + "_" + fn.name + "(" + params + ")");
        
        if (fn.body is BlockNode) {
            generateBlock(fn.body as BlockNode);
        } else {
            emit(";");
        }
        
        emit("");
    }
    
    // Generate variable declaration
    void generateVarDecl(VarDeclNode var) {
        string type = "int";
        if (var.typeAnnotation is BasicTypeNode) {
            type = (var.typeAnnotation as BasicTypeNode).name;
        }
        
        string line = "";
        if (var.isConst) line += "const ";
        line += type + " " + var.name;
        
        if (var.initializer != null) {
            line += " = ";
            line += generateExpression(var.initializer);
        }
        
        line += ";";
        emit(line);
    }
    
    // Generate block
    void generateBlock(BlockNode block) {
        emit("{");
        indent++;
        
        for (int i = 0; i < block.statements.length; i++) {
            generateStatement(block.statements[i]);
        }
        
        indent--;
        emit("}");
    }
    
    // Generate statement
    void generateStatement(ASTNode stmt) {
        if (stmt is BlockNode) {
            generateBlock(stmt as BlockNode);
        } else if (stmt is IfStatementNode) {
            generateIfStatement(stmt as IfStatementNode);
        } else if (stmt is WhileStatementNode) {
            generateWhileStatement(stmt as WhileStatementNode);
        } else if (stmt is ForStatementNode) {
            generateForStatement(stmt as ForStatementNode);
        } else if (stmt is ReturnStatementNode) {
            generateReturnStatement(stmt as ReturnStatementNode);
        } else if (stmt is VarDeclNode) {
            generateVarDecl(stmt as VarDeclNode);
        } else if (stmt is ExpressionStatementNode) {
            ExpressionStatementNode exprStmt = stmt as ExpressionStatementNode;
            emit(generateExpression(exprStmt.expression) + ";");
        }
    }
    
    // Generate if statement
    void generateIfStatement(IfStatementNode ifStmt) {
        emit("if (" + generateExpression(ifStmt.condition) + ")");
        generateStatement(ifStmt.thenBlock);
        
        if (ifStmt.elseBlock != null) {
            emit("else");
            generateStatement(ifStmt.elseBlock);
        }
    }
    
    // Generate while statement
    void generateWhileStatement(WhileStatementNode whileStmt) {
        emit("while (" + generateExpression(whileStmt.condition) + ")");
        generateStatement(whileStmt.body);
    }
    
    // Generate for statement
    void generateForStatement(ForStatementNode forStmt) {
        string init = "";
        if (forStmt.init != null) {
            init = generateExpression(forStmt.init);
        }
        
        string condition = "";
        if (forStmt.condition != null) {
            condition = generateExpression(forStmt.condition);
        }
        
        string update = "";
        if (forStmt.update != null) {
            update = generateExpression(forStmt.update);
        }
        
        emit("for (" + init + "; " + condition + "; " + update + ")");
        generateStatement(forStmt.body);
    }
    
    // Generate return statement
    void generateReturnStatement(ReturnStatementNode returnStmt) {
        if (returnStmt.value != null) {
            emit("return " + generateExpression(returnStmt.value) + ";");
        } else {
            emit("return;");
        }
    }
    
    // Generate expression
    string generateExpression(ASTNode expr) {
        if (expr is LiteralExprNode) {
            LiteralExprNode literal = expr as LiteralExprNode;
            if (literal.literalType == "string") {
                return literal.value;
            }
            return literal.value;
        } else if (expr is IdentifierExprNode) {
            return (expr as IdentifierExprNode).name;
        } else if (expr is BinaryExprNode) {
            BinaryExprNode binary = expr as BinaryExprNode;
            return generateExpression(binary.left) + " " + binary.operator + " " + generateExpression(binary.right);
        } else if (expr is UnaryExprNode) {
            UnaryExprNode unary = expr as UnaryExprNode;
            if (unary.isPrefix) {
                return unary.operator + generateExpression(unary.operand);
            } else {
                return generateExpression(unary.operand) + unary.operator;
            }
        } else if (expr is AssignmentExprNode) {
            AssignmentExprNode assign = expr as AssignmentExprNode;
            return generateExpression(assign.target) + " " + assign.operator + " " + generateExpression(assign.value);
        } else if (expr is CallExprNode) {
            CallExprNode call = expr as CallExprNode;
            string args = "";
            for (int i = 0; i < call.arguments.length; i++) {
                if (i > 0) args += ", ";
                args += generateExpression(call.arguments[i]);
            }
            return generateExpression(call.callee) + "(" + args + ")";
        } else if (expr is MemberExprNode) {
            MemberExprNode member = expr as MemberExprNode;
            if (member.member == "[]") {
                return generateExpression(member.object) + "[/* index */]";
            }
            return generateExpression(member.object) + "->" + member.member;
        }
        
        return "/* unknown expression */";
    }
    
    // Emit a line with proper indentation
    void emit(string line) {
        string indentStr = "";
        for (int i = 0; i < indent; i++) {
            indentStr += "    ";
        }
        output += indentStr + line + "\n";
    }
}
